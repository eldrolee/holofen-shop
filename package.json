{
  "name": "holofen",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply holofen --local --persist-to .wrangler/state",
    "check": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.53.0"
  }
}
